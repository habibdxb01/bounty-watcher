```java
package com.edgechains.lib.utils;

import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.*;
import java.util.function.Function;

/**
 * Utility to detect and redact Personally Identifiable Information (PII) using AWS Comprehend.
 */
public class AwsComprehendRedactionUtility implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final boolean managesClientLifecycle;

    public enum RedactionMaskType {
        TYPE_TAG,       // e.g. [NAME], [EMAIL], [SSN]
        GENERIC_TAG,    // e.g. [REDACTED]
        ASTERISKS       // e.g. ***
    }

    public static class RedactionConfig {
        private final LanguageCode languageCode;
        private final double minConfidenceScore;
        private final RedactionMaskType maskType;
        private final Set<PiiEntityType> includedEntityTypes;
        private final Function<PiiEntity, String> customMaskFunction;

        private RedactionConfig(Builder builder) {
            this.languageCode = builder.languageCode;
            this.minConfidenceScore = builder.minConfidenceScore;
            this.maskType = builder.maskType;
            this.includedEntityTypes = builder.includedEntityTypes;
            this.customMaskFunction = builder.customMaskFunction;
        }

        public static Builder builder() {
            return new Builder();
        }

        public static RedactionConfig defaultConfig() {
            return builder().build();
        }

        public static class Builder {
            private LanguageCode languageCode = LanguageCode.EN;
            private double minConfidenceScore = 0.6;
            private RedactionMaskType maskType = RedactionMaskType.TYPE_TAG;
            private Set<PiiEntityType> includedEntityTypes = Collections.emptySet();
            private Function<PiiEntity, String> customMaskFunction = null;

            public Builder languageCode(LanguageCode languageCode) {
                this.languageCode = Objects.requireNonNull(languageCode, "languageCode cannot be null");
                return this;
            }

            public Builder minConfidenceScore(double minConfidenceScore) {
                if (minConfidenceScore < 0.0 || minConfidenceScore > 1.0) {
                    throw new IllegalArgumentException("minConfidenceScore must be between 0.0 and 1.0");
                }
                this.minConfidenceScore = minConfidenceScore;
                return this;
            }

            public Builder maskType(RedactionMaskType maskType) {
                this.maskType = Objects.requireNonNull(maskType, "maskType cannot be null");
                return this;
            }

            public Builder includedEntityTypes(Set<PiiEntityType> includedEntityTypes) {
                this.includedEntityTypes = includedEntityTypes != null ? EnumSet.copyOf(includedEntityTypes) : Collections.emptySet();
                return this;
            }

            public Builder customMaskFunction(Function<PiiEntity, String> customMaskFunction) {
                this.customMaskFunction = customMaskFunction;
                return this;
            }

            public RedactionConfig build() {
                return new RedactionConfig(this);
            }
        }
    }

    public AwsComprehendRedactionUtility() {
        this(Region.US_EAST_1);
    }

    public AwsComprehendRedactionUtility(Region region) {
        this(ComprehendClient.builder()
                .region(region)
                .credentialsProvider(DefaultCredentialsProvider.create())
                .build(), true);
    }

    public AwsComprehendRedactionUtility(ComprehendClient comprehendClient) {
        this(comprehendClient, false);
    }

    private AwsComprehendRedactionUtility(ComprehendClient comprehendClient, boolean managesClientLifecycle) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient cannot be null");
        this.managesClientLifecycle = managesClientLifecycle;
    }

    /**
     * Detects PII entities in the provided text.
     */
    public List<PiiEntity> detectPii(String text, LanguageCode languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return Collections.emptyList();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return response.hasEntities() ? response.entities() : Collections.emptyList();
    }

    /**
     * Redacts PII entities from text using default configuration (English, TYPE_TAG).
     */
    public String redact(String text) {
        return redact(text, RedactionConfig.defaultConfig());
    }

    /**
     * Redacts PII entities from text according to provided configuration.
     */
    public String redact(String text, RedactionConfig config) {
        if (text == null || text.isEmpty()) {
            return text;
        }

        List<PiiEntity> entities = detectPii(text, config.languageCode);
        if (entities.isEmpty()) {
            return text;
        }

        // Sort entities descending by beginOffset to safely replace without invalidating previous offsets
        List<PiiEntity> sorted = new ArrayList<>(entities);
        sorted.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder redacted = new StringBuilder(text);
        int lastProcessedStart = Integer.MAX_VALUE;

        for (PiiEntity entity : sorted) {
            if (entity.score() != null && entity.score() < config.minConfidenceScore) {
                continue;
            }

            if (!config.includedEntityTypes.isEmpty() && !config.includedEntityTypes.contains(entity.type())) {
                continue;
            }

            int start = entity.beginOffset();
            int end = entity.endOffset();

            // Guard against out of bounds or overlapping entity offsets
            if (end > lastProcessedStart) {
                end = lastProcessedStart;
            }
            if (start >= end || start < 0 || end > redacted.length()) {
                continue;
            }

            String mask = getMask(entity, config);
            redacted.replace(start, end, mask);
            lastProcessedStart = start;
        }

        return redacted.toString();
    }

    private String getMask(PiiEntity entity, RedactionConfig config) {
        if (config.customMaskFunction != null) {
            return config.customMaskFunction.apply(entity);
        }

        switch (config.maskType) {
            case GENERIC_TAG:
                return "[REDACTED]";
            case ASTERISKS:
                return "***";
            case TYPE_TAG:
            default:
                return "[" + entity.typeAsString() + "]";
        }
    }

    @Override
    public void close() {
        if (managesClientLifecycle) {
            comprehendClient.close();
        }
    }
}
