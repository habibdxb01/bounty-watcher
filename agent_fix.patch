def parse_bounties(raw_text: str, algora_ids: List[str]) -> List[Dict]:
    pattern = re.compile(r"-\s*🔴\s*\*\*(\$\d+)\*\*\s*·\s*\[(.*?)\]\((.*?)\)")
    bounties = []
    lines = [line.strip() for line in raw_text.strip().splitlines() if line.strip()]

    for idx, line in enumerate(lines):
        match = pattern.search(line)
        if match:
            reward = match.group(1)
            title = match.group(2)
            url = match.group(3)
            bounty_id = algora_ids[idx] if idx < len(algora_ids) else f"auto-{idx}"
            bounties.append({
                "reward": reward,
                "title": title,
                "url": url,
                "id": bounty_id,
            })
    return bounties


def create_github_issue(title: str, body: str) -> bool:
    if not GITHUB_TOKEN or not GITHUB_REPOSITORY:
        print(f"[DRY-RUN] Create issue: {title}")
        return True

    url = f"https://api.github.com/repos/{GITHUB_REPOSITORY}/issues"
    payload = json.dumps({"title": title, "body": body}).encode("utf-8")

    req = urllib.request.Request(
        url,
        data=payload,
        headers={
            "Authorization": f"Bearer {GITHUB_TOKEN}",
            "Accept": "application/vnd.github+json",
            "Content-Type": "application/json",
            "User-Agent": "Bounty-Watcher-Backfill",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            print(f"Created issue #{data.get('number')}: {title}")
            return True
    except Exception as e:
        print(f"Failed to create issue for {title}: {e}", file=sys.stderr)
        return False


def run_backfill():
    bounties = parse_bounties(INITIAL_BOUNTIES_RAW, INITIAL_ALGORA_IDS)
    print(f"Parsed {len(bounties)} bounties for backfill.")

    seen_ids: Set[str] = set()
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                seen_ids = set(data) if isinstance(data, list) else set(data.keys())
        except Exception:
            seen_ids = set()

    created_count = 0
    for b in bounties:
        b_id = b["id"]
        if b_id in seen_ids:
            print(f"Skipping already seen bounty {b_id}: {b['title']}")
            continue

        issue_title = f"🔴 {b['reward']} · {b['title']}"
        issue_body = (
            f"### [{b['reward']}] {b['title']}\n\n"
            f"- **Source Issue:** {b['url']}\n"
            f"- **Reward:** {b['reward']}\n\n"
            f"cc @{CC_USER}\n\n"
            f"<!-- algora:gh-{b_id} -->\n"
        )

        if create_github_issue(issue_title, issue_body):
            seen_ids.add(b_id)
            created_count += 1
            with open(STATE_FILE, "w", encoding="utf-8") as f:
                json.dump(sorted(list(seen_ids)), f, indent=2)
            time.sleep(1)

    print(f"Backfill complete: created {created_count} individual issues.")


if __name__ == "__main__":
    run_backfill()
