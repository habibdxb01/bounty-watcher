package com.edgechains.lib.utils;

import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

class AwsComprehendRedactionUtilityTest {

    @Test
    void testRedactPiiEntities() {
        ComprehendClient mockClient = Mockito.mock(ComprehendClient.class);

        String sampleText = "Contact Jane Doe at jane.doe@example.com for details.";

        PiiEntity nameEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .score(0.99f)
                .beginOffset(8)
                .endOffset(16)
                .build();

        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .score(0.99f)
                .beginOffset(20)
                .endOffset(40)
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder()
                        .entities(List.of(nameEntity, emailEntity))
                        .build());

        try (AwsComprehendRedactionUtility redactor = new AwsComprehendRedactionUtility(mockClient)) {
            String redacted = redactor.redact(sampleText);
            assertEquals("Contact [NAME] at [EMAIL] for details.", redacted);

            AwsComprehendRedactionUtility.RedactionConfig config = AwsComprehendRedactionUtility.RedactionConfig.builder()
                    .maskType(AwsComprehendRedactionUtility.RedactionMaskType.GENERIC_TAG)
                    .build();

            String genericRedacted = redactor.redact(sampleText, config);
            assertEquals("Contact [REDACTED] at [REDACTED] for details.", genericRedacted);
        }
    }
}
