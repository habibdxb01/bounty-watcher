# watcher.py
"""
Bounty Watcher: Monitors Algora bounties and creates an individual GitHub issue
for every bounty discovered (ensuring no grouping into a single summary issue).
"""

import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
from typing import Dict, List, Optional, Set

GITHUB_TOKEN = os.getenv("GITHUB_TOKEN") or os.getenv("GH_TOKEN")
GITHUB_REPOSITORY = os.getenv("GITHUB_REPOSITORY")  # e.g., "habibdxb01/bounty-tracker"
STATE_FILE = os.getenv("STATE_FILE", "seen_bounties.json")
CC_USER = os.getenv("CC_USER", "habibdxb01")
ALGORA_API_URL = "https://api.algora.io/bounties"


def load_seen_bounties() -> Set[str]:
    """Load previously processed bounty IDs."""
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                return set(data) if isinstance(data, list) else set(data.keys())
        except Exception as e:
            print(f"Error loading {STATE_FILE}: {e}", file=sys.stderr)
    return set()


def save_seen_bounties(seen_ids: Set[str]) -> None:
    """Save processed bounty IDs to disk."""
    try:
        with open(STATE_FILE, "w", encoding="utf-8") as f:
            json.dump(sorted(list(seen_ids)), f, indent=2)
    except Exception as e:
        print(f"Error saving {STATE_FILE}: {e}", file=sys.stderr)


def fetch_algora_bounties() -> List[Dict]:
    """Fetch current bounties from Algora API."""
    req = urllib.request.Request(
        ALGORA_API_URL,
        headers={"User-Agent": "Algora-Bounty-Watcher/1.0"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            if isinstance(data, dict) and "items" in data:
                return data["items"]
            elif isinstance(data, list):
                return data
            return []
    except Exception as e:
        print(f"Failed to fetch bounties from Algora: {e}", file=sys.stderr)
        return []


def create_github_issue(title: str, body: str) -> Optional[int]:
    """Create a new GitHub issue in the target repository."""
    if not GITHUB_TOKEN or not GITHUB_REPOSITORY:
        print(
            f"[DRY-RUN] Would create issue:\nTitle: {title}\nBody:\n{body}\n{'-'*40}"
        )
        return None

    url = f"https://api.github.com/repos/{GITHUB_REPOSITORY}/issues"
    payload = json.dumps({"title": title, "body": body}).encode("utf-8")

    req = urllib.request.Request(
        url,
        data=payload,
        headers={
            "Authorization": f"Bearer {GITHUB_TOKEN}",
            "Accept": "application/vnd.github+json",
            "Content-Type": "application/json",
            "User-Agent": "Bounty-Watcher-Bot",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            res_data = json.loads(resp.read().decode("utf-8"))
            issue_number = res_data.get("number")
            print(f"Created issue #{issue_number}: {title}")
            return issue_number
    except urllib.error.HTTPError as e:
        error_body = e.read().decode("utf-8")
        print(
            f"HTTP error creating issue: {e.code} - {error_body}",
            file=sys.stderr,
        )
    except Exception as e:
        print(f"Error creating issue: {e}", file=sys.stderr)
    return None


def format_issue_title(reward: str, title: str) -> str:
    """Format standard bounty issue title."""
    reward_clean = reward.strip().replace("**", "")
    return f"🔴 {reward_clean} · {title.strip()}"


def format_issue_body(
    title: str, reward: str, url: str, bounty_id: str
) -> str:
    """Format issue body with bounty reference, CC mention, and tracking comment."""
    cc_text = f"cc @{CC_USER}" if CC_USER else ""
    return (
        f"### [{reward}] {title}\n\n"
        f"- **Source Issue:** {url}\n"
        f"- **Reward:** {reward}\n\n"
        f"{cc_text}\n\n"
        f"<!-- algora:gh-{bounty_id} -->\n"
    )


def process_bounty(bounty: Dict, seen_ids: Set[str]) -> bool:
    """Process a single bounty and create an individual issue if not yet seen."""
    bounty_id = str(
        bounty.get("id")
        or bounty.get("gh_id")
        or bounty.get("algora_id")
        or ""
    )
    if not bounty_id:
        return False

    if bounty_id in seen_ids:
        return False

    title = bounty.get("title", "Untitled Bounty")
    reward = bounty.get("reward") or bounty.get("amount") or "$0"
    if not str(reward).startswith("$"):
        reward = f"${reward}"
    url = bounty.get("url") or bounty.get("html_url") or ""

    issue_title = format_issue_title(reward, title)
    issue_body = format_issue_body(title, reward, url, bounty_id)

    create_github_issue(issue_title, issue_body)
    seen_ids.add(bounty_id)
    save_seen_bounties(seen_ids)
    return True


def run_watcher():
    """Main watcher execution loop/run."""
    seen_ids = load_seen_bounties()
    bounties = fetch_algora_bounties()

    new_count = 0
    for bounty in bounties:
        if process_bounty(bounty, seen_ids):
            new_count += 1
            time.sleep(1)  # Rate limit margin between issue creations

    print(f"Watcher execution complete. {new_count} new issues created.")


if __name__ == "__main__":
    run_watcher()
```

